# 前端环境变量示例（复制为 .env / .env.local 后按需修改）
# 注意：变量名以 VITE_ 开头才能暴露给客户端代码。
# 后端代理目标（vite.config.js server.proxy 读取，缺省 http://127.0.0.1:5000）
VITE_APP_API_BASE_URL=http://127.0.0.1:5000

# 演示模式开关（report.vue / platform.vue 读取，缺省关闭）
VITE_DEMO_MODE=false

# 传播分析默认文章 ID（propagation.vue 读取，缺省空）
VITE_DEFAULT_ARTICLE_ID=
